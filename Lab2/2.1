#include <iostream>
#include <thread>
#include <mutex>
#include <queue>
#include <chrono>
#include <string>
#include <windows.h>

using namespace std;

queue<int> numbers;
mutex m;
bool flag = false;

bool isPrime(int n)
{
    if (n < 2) return false;

    for (int i = 2; i <= n / i; ++i)
        if (n % i == 0) return false;

    return true;
}

void DataPreparation()
{
    cout << "Введіть цілі числа (q - завершити):" << endl;
    string input;

    while (cin >> input)
    {
        if (input == "q" || input == "Q")
            break;

        try
        {
            size_t pos = 0;
            int number = stoi(input, &pos);

            if (pos != input.size())
            {
                cout << "Введіть ціле число або q." << endl;
                continue;
            }

            lock_guard<mutex> lock(m);
            numbers.push(number);
        }
        catch (...)
        {
            cout << "Введіть ціле число або q." << endl;
        }
    }

    {
        lock_guard<mutex> lock(m);
        flag = true;
    }
}

void DataProcessing()
{
    unique_lock<mutex> lock(m);

    while (!flag)
    {
        lock.unlock();
        this_thread::sleep_for(chrono::milliseconds(100));
        lock.lock();
    }

    cout << "Прості числа: ";

    while (!numbers.empty())
    {
        int number = numbers.front();
        numbers.pop();

        if (isPrime(number))
            cout << number << " ";
    }

    cout << endl;
}

int main()
{

    SetConsoleCP(1251);
	SetConsoleOutputCP(1251);

    thread preparation(DataPreparation);
    preparation.detach();

    DataProcessing();

    cout << "Програму завершено." << endl;
    return 0;
}
